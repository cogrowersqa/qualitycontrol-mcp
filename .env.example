# ─────────────────────────────────────────────
# QualityControl MCP Server — Variables de Entorno
# ─────────────────────────────────────────────
# Copiar a .env y completar los valores

# ═══ API REST ═══
API_BASE_URL=https://developers.cogrowers.cl/heladas
API_TIMEOUT_MS=30000
API_VALIDATE_ENDPOINT=api_toda_info.php
API_DEVICES_ENDPOINT=api_toda_info.php
API_HISTORY_ENDPOINT=api_toda_info.php
API_WEATHER_ENDPOINT=api_toda_info.php

# ═══ CIFRADO ═══
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ═══ SESIONES ═══
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_MIN=60

# ═══ CACHE ═══
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# ═══ LOGS ═══
LOG_LEVEL=info
LOG_DIR=./logs

# ═══ SERVER ═══
NODE_ENV=production
MCP_BASE_URL=https://qa.cogrowers.cl/mcp/qualitycontrol
OAUTH_LOGO_URL=https://web.cogrowers.cl/lovable-uploads/e945d53e-8ff3-45c8-b232-9e290210403c.png
OAUTH_FAVICON_URL=https://cogrowers.cl/heladas/img/isotipo.png
