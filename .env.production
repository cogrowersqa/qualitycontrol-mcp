# ─── QualityControl MCP Server — Producción ─────────────────────────
# Copiar como .env en el servidor

# API REST de QualityControl
API_BASE_URL=https://developers.cogrowers.cl/heladas
API_TIMEOUT_MS=30000
API_VALIDATE_ENDPOINT=api_toda_info.php
API_DEVICES_ENDPOINT=api_toda_info.php
API_HISTORY_ENDPOINT=api_toda_info.php
API_WEATHER_ENDPOINT=api_toda_info.php

# Cifrado de API Keys (CAMBIAR en producción — generar con: openssl rand -hex 32)
ENCRYPTION_KEY=CAMBIAR_ESTO_generar_con_openssl_rand_hex_32

# Sesiones
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_MIN=60

# Cache
CACHE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=500

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Server
NODE_ENV=production
MCP_PORT=3100
MCP_HOST=0.0.0.0
MCP_BASE_URL=https://qa.cogrowers.cl/mcp/qualitycontrol
OAUTH_LOGO_URL=https://web.cogrowers.cl/lovable-uploads/e945d53e-8ff3-45c8-b232-9e290210403c.png
OAUTH_FAVICON_URL=https://qa.cogrowers.cl/mcp/qualitycontrol/assets/Logo_COGROWERS-Calidad.png
