# ─── AgroClimate MCP Server — Producción ───────────────────────────
# Copiar como .env en el servidor

# API REST de AgroClimate
API_BASE_URL=https://developers.cogrowers.cl/heladas
API_TIMEOUT_MS=30000

# Cifrado de API Keys (CAMBIAR en producción — generar con: openssl rand -hex 32)
ENCRYPTION_KEY=CAMBIAR_ESTO_generar_con_openssl_rand_hex_32

# Sesiones
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_MIN=60

# Cache
CACHE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=500

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Server
NODE_ENV=production
MCP_PORT=3100
MCP_HOST=0.0.0.0
